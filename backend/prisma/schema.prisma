// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  name          String
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  salaryProfile SalaryProfile?
  expenses      Expense[]
  deductions    MonthlyDeduction[]
  auditEvents   AuditEvent[]

  @@map("users")
}

enum EmploymentType {
  REGULAR       @map("regular")
  CONTRACTUAL   @map("contractual")
  SELF_EMPLOYED @map("self_employed")
}

model SalaryProfile {
  id                String             @id @default(uuid())
  userId            String             @unique @map("user_id")
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  grossSalary       Decimal            @db.Decimal(10, 2) @map("gross_salary")
  employmentType    EmploymentType     @map("employment_type")
  needsPercentage   Decimal            @default(50.0) @db.Decimal(5, 2) @map("needs_percentage")
  wantsPercentage   Decimal            @default(30.0) @db.Decimal(5, 2) @map("wants_percentage")
  savingsPercentage Decimal            @default(20.0) @db.Decimal(5, 2) @map("savings_percentage")
  effectiveDate     DateTime           @map("effective_date")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  deductions        MonthlyDeduction[]

  @@map("salary_profiles")
}

enum AllocationBucket {
  NEEDS   @map("needs")
  WANTS   @map("wants")
  SAVINGS @map("savings")
}

model Expense {
  id               String           @id @default(uuid())
  userId           String           @map("user_id")
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount           Decimal          @db.Decimal(10, 2)
  category         String
  allocationBucket AllocationBucket @map("allocation_bucket")
  description      String?
  expenseDate      DateTime         @map("expense_date")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  @@map("expenses")
}

model MonthlyDeduction {
  id                    String        @id @default(uuid())
  userId                String        @map("user_id")
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  salaryProfileId       String        @map("salary_profile_id")
  salaryProfile         SalaryProfile @relation(fields: [salaryProfileId], references: [id], onDelete: Cascade)
  monthYear             String        @map("month_year")
  grossSalary           Decimal       @db.Decimal(10, 2) @map("gross_salary")
  sssContribution       Decimal       @db.Decimal(10, 2) @map("sss_contribution")
  pagibigContribution   Decimal       @db.Decimal(10, 2) @map("pagibig_contribution")
  philhealthContribution Decimal      @db.Decimal(10, 2) @map("philhealth_contribution")
  incomeTax             Decimal       @db.Decimal(10, 2) @map("income_tax")
  totalDeductions       Decimal       @db.Decimal(10, 2) @map("total_deductions")
  netSalary             Decimal       @db.Decimal(10, 2) @map("net_salary")
  createdAt             DateTime      @default(now()) @map("created_at")

  @@unique([userId, monthYear])
  @@map("monthly_deductions")
}

enum AuditAction {
  CREATE      @map("create")
  UPDATE      @map("update")
  DELETE      @map("delete")
  RECALCULATE @map("recalculate")
}

model AuditEvent {
  id            String      @id @default(uuid())
  userId        String      @map("user_id")
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  entityType    String      @map("entity_type")
  entityId      String      @map("entity_id")
  action        AuditAction
  payloadBefore Json?       @map("payload_before")
  payloadAfter  Json?       @map("payload_after")
  createdAt     DateTime    @default(now()) @map("created_at")

  @@map("audit_events")
}


